{
  "Dcc": {
    "Port": "/dev/ttyACM0",
    //    "MaxSpeed": 1,
    "MaxSpeed": 0.4,
    "SlowThrottleValue": 0.15,
    "ThrottleStep": 0.1
  },
  "Mqtt": {
    "Host": "192.168.20.201",
    "Port": 1883
  },
  "Turnout": {
    "CommandTopic": "driveatrain/turnout/cmd",
    "Locations": [
      {
        "Pin": 12,
        "X": 960,
        "Y": 900,
        "Rotation": 90,
        "Reverse": false
      }
    ]
  },
  "Camera": {
    "Flip": true,
    "BirdsEyeCameraName": "/dev/video0",
    "PovCameraUrl": "http://192.168.20.101:81/stream",
    // Resolution pushed to the POV camera on startup. The sketch resets the camera to
    // QVGA on every boot and never saves the setting, so this is re-applied each time.
    // Values (OV2640, the sensor on the AI-Thinker board):
    //   13 = UXGA   1600x1200
    //   12 = SXGA   1280x1024
    //   11 = HD     1280x720
    //   10 = XGA    1024x768
    //    9 = SVGA   800x600
    //    8 = VGA    640x480
    //    7 = HVGA   480x320
    //    6 = CIF    400x296
    //    5 = QVGA   320x240   <- the sketch's boot default
    //    4 =        240x240
    //    3 = HQVGA  240x176
    //    2 = QCIF   176x144
    //    1 = QQVGA  160x120
    //    0 =         96x96
    // Higher is sharper but slower over wifi; the ESP32 cannot sustain 30fps near the top.
    "PovCameraFrameSize": 5
  },
  "FirstRun": false,
  "Headless": false,
  "Vision": {
    "SlowWhenPixelsLessThan": 50,
    "StopWhenPixelsLessThan": 15,
    // TODO need a seperate "uncouple min distance". So a unit can't be left at the edge of a path and mess up the turnout clearance
    "TurnoutClearance": 50
  },
  "Units": [
    {
      "Name": "Western Maryland",
      "Type": "Locomotive",
      "Address": 3,
      "FrontCouplerIndex": 0,
      "BackCouplerIndex": 1,
      "DirMarkerOnBack": true
    },
    {
      "Name": "Boxcar 1",
      "Type": "Wagon",
      // actually 3
      "Address": 4,
      "FrontCouplerIndex": 0,
      "BackCouplerIndex": 1
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
